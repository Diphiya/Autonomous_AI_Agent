# Which LLM to use. "mock" = offline deterministic stand-in (no key needed).
# Otherwise "<provider>:<model>", passed to LangChain's init_chat_model:
#   openai:gpt-4o-mini | anthropic:claude-haiku-5-5 | groq:llama-3.3-70b-versatile | ollama:llama3.1
LLM_MODEL=mock
# Leave empty unless your model supports it (newer Claude models reject `temperature`).
LLM_TEMPERATURE=
LLM_TIMEOUT_S=45

# Provider keys (only the one you use)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=...

# Execution limits
MAX_STEPS_PER_TURN=6
MAX_TOOL_CALLS_PER_TURN=4
LLM_MAX_RETRIES=2
TOOL_TIMEOUT_S=60
MAX_CONSECUTIVE_CLARIFICATIONS=2
GRAPH_RECURSION_LIMIT=40
HISTORY_WINDOW=10

# Persistence: empty = in-memory; a path = SQLite (survives restarts)
CHECKPOINT_DB=

# Demo endpoint for injecting faults. Set false in production.
ALLOW_FAULT_INJECTION=true
